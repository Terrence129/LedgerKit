{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ledgerkit.local/schemas/golden-normalized-events-v1.json",
  "title": "LedgerKit normalized events v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture_id", "scenarios", "canonical_hash"],
  "properties": {
    "fixture_id": { "type": "string" },
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "events"],
        "properties": {
          "scenario_id": { "type": "string" },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["event_id", "event_type", "effective_date", "sequence", "status", "detail", "calculation_version"],
              "properties": {
                "event_id": { "type": "string" },
                "event_type": { "type": "string" },
                "effective_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
                "sequence": { "type": "integer", "minimum": 1 },
                "status": { "enum": ["posted", "evidence-only"] },
                "detail": { "type": "object" },
                "calculation_version": { "const": "ledger-calculation-v1" }
              }
            }
          }
        }
      }
    },
    "canonical_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
