{
  "name": "ledgerkit-tauri-spike",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "check": "npm run check:fixture && npm run build && npm test",
    "generate:fixture": "node tools/generate-10k-xlsx.mjs",
    "check:fixture": "node tools/generate-10k-xlsx.mjs --check",
    "bench:ts-xlsx": "node --expose-gc tools/benchmark-ts-xlsx.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build:standard": "tauri build --bundles nsis",
    "tauri:build:offline": "tauri build --bundles nsis --config src-tauri/tauri.offline.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.10.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "exceljs": "4.4.0",
    "jszip": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
