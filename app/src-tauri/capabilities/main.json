{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The local main window can call only the nineteen reviewed setup, catalog, cash, query, and initial-import operations.",
  "windows": ["main"],
  "permissions": [
    "core:app:default",
    "allow-create-ledger",
    "allow-open-ledger",
    "allow-get-ledger-status",
    "allow-update-settings",
    "allow-save-institution",
    "allow-save-cash-account",
    "allow-save-category",
    "allow-save-portfolio",
    "allow-save-instrument",
    "allow-save-fx-revision",
    "allow-save-price-revision",
    "allow-preview-event",
    "allow-post-event",
    "allow-revise-event",
    "allow-reverse-event",
    "allow-get-expense-analysis",
    "allow-get-activity",
    "allow-analyze-import",
    "allow-commit-import"
  ]
}
